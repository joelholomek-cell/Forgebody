{
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/join", "destination": "/join.html" },
    { "source": "/join/", "destination": "/join.html" },
    { "source": "/join/:code", "destination": "/join.html" },
    { "source": "/join/:code/", "destination": "/join.html" }
  ]
}
